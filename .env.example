# RevenueCat Configuration
# Get your Android public SDK key from RevenueCat dashboard
# https://app.revenuecat.com/
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# API Configuration
# Your backend API base URL
EXPO_PUBLIC_API_BASE_URL=https://api.recordioai.com/v1

# Environment
# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# AI Agent Provider Configuration (optional)
# These are placeholder examples - configure based on your integrations
# EXPO_PUBLIC_RETELL_API_KEY=
# EXPO_PUBLIC_VAPI_API_KEY=
# EXPO_PUBLIC_BLAND_API_KEY=

# Feature Flags
# EXPO_PUBLIC_ENABLE_TEST_MODE=false