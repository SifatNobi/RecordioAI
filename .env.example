# API Configuration
# Your backend API base URL
EXPO_PUBLIC_API_BASE_URL=https://recordioai.onrender.com/v1

# Environment
# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# AI provider secrets (backend only, never commit actual values)
# Meta Muse Voice Transcribe (primary when configured)
# META_API_KEY=replace_with_your_meta_model_api_key
# META_ASR_MODEL=muse-voice-transcribe-1.0
# META_ASR_TIMEOUT_SECONDS=120
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# Groq Whisper fallback (used automatically if Meta is not configured or fails)
# GROQ_API_KEY=replace_with_your_groq_api_key
# EMERGENT_LLM_KEY=replace_with_your_emergent_key
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=recordioai
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-2.5-flash

# Frontend-only public config
EXPO_PUBLIC_ENABLE_TEST_MODE=false
EXPO_PUBLIC_BLOCKCHAIN_ENABLED=true
EXPO_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_MONAD_TESTNET_CHAIN_ID=10143
EXPO_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=b889ec40fdf5db096d981559f7ccbdb2