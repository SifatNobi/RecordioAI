{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "outDir": "./out",
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "files": [
    "./globals.d.ts",
    "../../src/services/blockchain/monad.ts",
    "../../src/constants/env.ts"
  ]
}
